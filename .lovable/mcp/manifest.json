  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://bxqichxpvnlofqsjdcdg.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "cmg-admin-mcp",
      "version": "0.1.0",
      "title": "CMG Admin MCP"
    },
    "tools": [
      {
